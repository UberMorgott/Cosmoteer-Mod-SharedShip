ID = morgott.unified_fleet_control
Name = "Unified Fleet Control"
Version = "1.0.0"
CompatibleGameVersions = ["0.30.2b"]
ModifiesGameplay = true
Author = "Morgott"
Description = "This mod combines universal ship control and shared resources for all human players (0-7).\n\n"\
              "FEATURES:\n"\
              "- All human players can control any ship in the fleet\n"\
              "- Shared resource pool across all player ships\n"\
              "- Shared construction capabilities\n"\
              "- Shared money and credits\n"\
              "- Shared rewards and earnings\n"\
              "- Perfect for coordinated team play\n"\
              "- Works in both multiplayer and single-player modes\n\n"\
              "This mod requires Enhanced Mod Loader (EML) to function."
RequiredMods = [
    "electrosr.eml"
]
DLL = "unified_fleet_control.dll"