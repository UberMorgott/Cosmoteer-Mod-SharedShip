ID = "morgott.sharedship"
Name = "Shared Ship (co-op)"
Version = "0.1.0"
Author = "Morgott"
CompatibleGameVersions = ["0.30.5"]
Description = "Career co-op: put [S] in a ship's name (or select it and press Ctrl+Shift+H) and every human player in the game can command it, fly it, fire its weapons, manage its crew and build on it. It also appears in each teammate's own-ship lists. Other ships stay vanilla. ALL players must run the same version of this mod. Requires Yet Another Mod Loader."
Dependencies = ["3577650065"]
ModifiesMultiplayer = true
