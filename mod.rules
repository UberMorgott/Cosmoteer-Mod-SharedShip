ID = "morgott.sharedship"
Name = "Shared Ship (co-op)"
Version = "0.4.0"
Author = "Morgott"
CompatibleGameVersions = ["0.30.5"]
Description = "Career co-op: in the ship menu 'Transfer ship control...' pick 'Everyone (shared ship)' (or press Ctrl+Shift+H, or put [S] in the name) and every human player in the game treats it as their own ship: command it, fly it, fire its weapons, manage its crew and build on it; its crew helps build and repair their ships and resources flow both ways as between own ships. It also appears in each teammate's own-ship lists. Other ships stay vanilla. ALL players must run the same version of this mod. Requires Yet Another Mod Loader."
Dependencies = ["3577650065"]
ModifiesMultiplayer = true
StringsFolder = "strings"
